{
  "name": "ember-notebook-explorer",
  "displayName": "Ember Notebook Explorer",
  "description": "Interactive graph visualization for Jupyter notebooks",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ember-notebook",
          "title": "Ember Notebook",
          "icon": "$(notebook)"
        }
      ]
    },
    "views": {
      "ember-notebook": [
        {
          "id": "emberNotebookOutline",
          "name": "Notebook Outline",
          "icon": "$(list-tree)",
          "contextualTitle": "Ember Notebook Outline"
        }
      ]
    },
    "commands": [
      {
        "command": "ember.showGraph",
        "title": "Show Notebook Graph",
        "category": "Ember"
      },
      {
        "command": "ember.showWalkthrough",
        "title": "Show Notebook Walkthrough",
        "category": "Ember"
      },
      {
        "command": "emberNotebookOutline.reveal",
        "title": "Reveal in Notebook",
        "category": "Ember"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .ipynb",
          "command": "ember.showGraph",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .ipynb",
          "command": "ember.showWalkthrough",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ember Notebook Explorer",
      "properties": {
        "emberNotebook.disableCache": {
          "type": "boolean",
          "default": false,
          "description": "Disable caching and force fresh analysis of notebooks"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.3"
  },
  "dependencies": {}
}