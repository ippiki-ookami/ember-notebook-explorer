    {
      "id": "7331e61560032a4f",
      "type": "text",
      "text": "Hours\n\n7/30 6am-7:30am, 1pm-3pm --- 3h\n7/31 10am-12pm & 8pm-9pm --- 3h\n8/1 10am-4pm --- 6h\n8/4 7am-10am --- 3h\n8/5 10am-5pm --- 7h",
